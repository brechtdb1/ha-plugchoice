{
  "config": {
    "step": {
      "user": {
        "title": "Plugchoice",
        "description": "Create a token in the Plugchoice portal (Settings → Personal access tokens) and paste it here. The integration is read-only by default; enable control later in the options.",
        "data": {
          "token": "Personal access token"
        }
      },
      "charger": {
        "title": "Choose the charger",
        "data": {
          "charger_uuid": "Charger"
        }
      },
      "reauth_confirm": {
        "title": "New Plugchoice token",
        "description": "The token was rejected. Create a new token and paste it here.",
        "data": {
          "token": "Personal access token"
        }
      }
    },
    "error": {
      "invalid_auth": "Invalid or revoked token.",
      "cannot_connect": "Cannot connect to the Plugchoice API."
    },
    "abort": {
      "already_configured": "This charger is already configured.",
      "no_chargers": "No chargers on this account.",
      "reauth_successful": "Token updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Plugchoice options",
        "description": "Only enable 'Allow control' when nothing else (e.g. another OCPP backend) controls the charger, or the two will overwrite each other's charge limits.",
        "data": {
          "scan_interval": "Polling interval",
          "allow_control": "Allow control (charge limit, start/stop)",
          "id_token": "ID token for 'Start charging' (optional)"
        }
      }
    }
